<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tabbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:background="#0B101A">

            <TextView
                android:id="@+id/appMark"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="d"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/address_glass" />

            <TextView
                android:id="@+id/tabTitle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="13dp"
                android:paddingEnd="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="dumbNavigator"
                android:textColor="#EAF0FF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#B9C5D9"
                android:textSize="12sp"
                android:background="@drawable/address_glass" />

            <Button
                android:id="@+id/newTab"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:text="+"
                android:textSize="21sp"
                android:textColor="#F2F6FF"
                android:contentDescription="Nueva pestaña" />
        </LinearLayout>

        <View
            android:id="@+id/progressTrack"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#121A28" />

        <FrameLayout
            android:id="@+id/engine"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0A0E16" />

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="9dp"
            android:padding="7dp"
            android:gravity="center_vertical"
            android:background="@drawable/toolbar_glass"
            android:elevation="16dp">

            <Button android:id="@+id/back" android:layout_width="40dp" android:layout_height="44dp" android:text="‹" android:contentDescription="Atrás" />
            <Button android:id="@+id/forward" android:layout_width="40dp" android:layout_height="44dp" android:layout_marginStart="3dp" android:text="›" android:contentDescription="Adelante" />

            <EditText
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="5dp"
                android:singleLine="true"
                android:hint="dumb:// dirección interna"
                android:textColor="#F7F9FF"
                android:textColorHint="#8997AD"
                android:textSize="14sp"
                android:background="@drawable/address_glass"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:inputType="textUri" />

            <Button android:id="@+id/go" android:layout_width="42dp" android:layout_height="44dp" android:text="→" android:contentDescription="Ir" />
            <Button android:id="@+id/reload" android:layout_width="42dp" android:layout_height="44dp" android:layout_marginStart="3dp" android:text="↻" android:contentDescription="Recargar" />
            <Button android:id="@+id/home" android:layout_width="42dp" android:layout_height="44dp" android:layout_marginStart="3dp" android:text="⌂" android:contentDescription="Inicio" />
            <Button android:id="@+id/bookmark" android:layout_width="42dp" android:layout_height="44dp" android:layout_marginStart="3dp" android:text="☆" android:contentDescription="Marcador" />
            <Button android:id="@+id/menu" android:layout_width="42dp" android:layout_height="44dp" android:layout_marginStart="3dp" android:text="⋮" android:contentDescription="Menú" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
