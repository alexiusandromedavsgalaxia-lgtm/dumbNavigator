<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B0B10">
 <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:padding="8dp" android:gravity="center_vertical" android:background="#12121A">
  <Button android:id="@+id/back" android:layout_width="42dp" android:layout_height="42dp" android:text="‹" android:textSize="24sp"/>
  <Button android:id="@+id/forward" android:layout_width="42dp" android:layout_height="42dp" android:text="›" android:textSize="24sp"/>
  <EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:singleLine="true" android:hint="dumb://" android:textColor="#FFFFFF" android:hintTextColor="#777783" android:background="#1C1C27" android:paddingStart="12dp" android:paddingEnd="12dp" android:inputType="textUri"/>
  <Button android:id="@+id/go" android:layout_width="52dp" android:layout_height="42dp" android:text="GO"/>
 </LinearLayout>
 <FrameLayout android:id="@+id/engine" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
