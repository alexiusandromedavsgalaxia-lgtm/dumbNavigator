<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07090F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical"
        android:background="#121722">

        <Button
            android:id="@+id/back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="‹"
            android:textSize="27sp"
            android:textColor="#EAF2FF"
            android:backgroundTint="#1B2432"
            android:contentDescription="Atrás" />

        <Button
            android:id="@+id/forward"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:text="›"
            android:textSize="27sp"
            android:textColor="#EAF2FF"
            android:backgroundTint="#1B2432"
            android:contentDescription="Adelante" />

        <EditText
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:hint="Buscar o escribir una dirección dumb://"
            android:textColor="#F4F7FF"
            android:textColorHint="#8994A8"
            android:background="#1A2230"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:inputType="textUri" />

        <Button
            android:id="@+id/go"
            android:layout_width="52dp"
            android:layout_height="42dp"
            android:text="↵"
            android:textSize="19sp"
            android:textColor="#EAF2FF"
            android:backgroundTint="#243247"
            android:contentDescription="Ir" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#263247" />

    <FrameLayout
        android:id="@+id/engine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0E16" />
</LinearLayout>
